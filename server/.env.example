# ==============================================
# OVH 控制台 (Go server) - 配置文件
# 复制此文件为 .env 并修改配置值
# ==============================================

# API 安全密钥（用于验证前后端通信）
# 生成方法: openssl rand -base64 32
# 与前端设置页中的密钥保持一致
#
# ⚠️ 下面这个 123456 是示例值，它明文写在公开仓库里，等于没有密钥。
#    配上 LISTEN_HOST 默认空（监听所有网卡），同网段任何人都能用它
#    下单 / 重装 / 删你的机器。没改的话后端启动时会大声告警。
API_SECRET_KEY=123456

# 后端端口
PORT=19998

# 调试模式（开发: true, 生产: false）
DEBUG=false

# 是否启用 API 密钥验证
ENABLE_API_KEY_AUTH=true

# 监听地址。默认空 = 所有网卡（localhost / 127.0.0.1 / 局域网 IP 都能访问）
# 想锁回环写 127.0.0.1；公网部署写 0.0.0.0
LISTEN_HOST=

# Gin 模式: debug / release
GIN_MODE=release

# 数据库加密密钥（首次启动自动生成并写回这个文件，通常不用自己填）
# 加密的是数据库里的 OVH API 凭据和 Telegram Token —— 拿到 sniper.db
# 就等于拿到你 OVH 账户的完全控制权（能下单、能重装、能删机器）。
#
# 备份配置文件时别漏了这一行：丢了它，已保存的账户就再也解不开，只能重新录入。
# 想让密钥完全不落盘，就用环境变量传进来（容器里推荐这么做），这个文件里就别写。
# OVH_DB_KEY=

# 配置文件自身的位置。默认是工作目录下的 .env。
# systemd / docker 里工作目录未必是程序所在目录，那种情况下写绝对路径，
# 否则密钥可能"这次写进去、下次找不到"。
# OVH_ENV_FILE=/etc/ovh-console/.env

# 在线更新的来源。默认是上游 gokele/ovh 的 GitHub Releases。
#
# 跑的是自己的 fork 时必须改这里，否则「在线更新」会把你的版本覆盖成上游的，
# 你自己的改动全没了 —— 而且它不会报错，看起来就是一次正常更新。
#
#   OVH_UPDATE_API=https://api.github.com/repos/<你的用户名>/<仓库名>/releases/latest
#
# 这个地址返回的 JSON 里必须有：
#   - 名字形如 ovh-server-<系统>-<架构>（Windows 多个 .exe）的附件
#   - 一个 checksums.txt，里面有对应文件的 sha256
#     （没有它会直接拒绝更新，不给"要不要冒险"的选项）
#
# 版本号只比前三段，而且**不能**用四段或后缀：
#   0.1.16    → 比 0.1.15 新 ✅
#   0.2.0     → 比 0.1.15 新 ✅
#   0.1.15-1  → 解析成 0.1.15，不算更新 ❌
#   0.1.15.1  → 解析成 0.1.0，比 0.1.15 还旧 ❌
#
# 检查更新和真正下载用的是同一个地址，所以不会出现"显示有新版、装上的却是另一个"。
# OVH_UPDATE_API=
